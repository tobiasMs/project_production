@push('custom_script')
<script>
    $(document).ready(function() {
        $('#product').DataTable({
            "processing": true,
            "serverSide": true,
            "ajax": "{{ route('product.data') }}",
            "columns": [
                { "data": "name" },
                { "data": "position" },
                { "data": "office" },
                { "data": "age" },
                { "data": "start_date" },
                { "data": "salary" }
            ]
        });
    });
</script>
